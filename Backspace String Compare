class Solution {
    public boolean backspaceCompare(String s, String t) {
        Stack<Character> st=new Stack<>();
        for(int i=0;i<s.length();i++){
            char ch1=s.charAt(i);
           {
            if(ch1=='#'){
                 if(!st.isEmpty())

                st.pop();
            }
            
            else{
                st.push(ch1);
            }
            }

        }
        Stack<Character> st2=new Stack<>();
        for(int j=0;j<t.length();j++){
            char ch2=t.charAt(j);
           
            if(ch2=='#'){
                 if(!st2.isEmpty())
                st2.pop();
            
            }
            else{
                st2.push(ch2);
            }
        }
        return st.equals(st2);

    }
}
